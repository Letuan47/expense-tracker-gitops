# Ansible Managed: /etc/rancher/k3s/config.yaml
write-kubeconfig-mode: "{{ k3s_kubeconfig_mode }}"
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
tls-san:
  - "{{ ansible_host }}"
  - "{{ staging_domain }}"
  - "127.0.0.1"
{% if k3s_disable_components | length > 0 %}
disable:
{% for comp in k3s_disable_components %}
  - "{{ comp }}"
{% endfor %}
{% endif %}
kubelet-arg:
  - "container-log-max-size={{ k3s_container_log_max_size }}"
  - "container-log-max-files={{ k3s_container_log_max_files }}"
  - "image-gc-high-threshold={{ k3s_image_gc_high_threshold }}"
  - "image-gc-low-threshold={{ k3s_image_gc_low_threshold }}"
  - "eviction-hard={{ k3s_eviction_hard }}"
  - "fail-swap-on=false"
